# SAM-Decoding evaluation environment variables.
# Copy to .env (gitignored) and fill in your local paths / secrets.
#
#   cp .env.example .env
#   # then edit .env

# --- Required: GPU runtime paths ---
MODEL_PATH=/root/aicloud-data/Models/Meta-Llama-3.1-8B-Instruct
TREE_MODEL_PATH=/root/aicloud-data/Models/EAGLE3-LLaMA3.1-Instruct-8B

# --- Optional: static SAM cache; leave empty to use DynSAM only ---
SAM_PATH=

# --- Optional: benchmark runtime defaults ---
DTYPE=float16
MEDQA_NUM_QUESTIONS=80
MEDQUAD_NUM_QUESTIONS=200
MAX_NEW_TOKENS=512
MAX_CACHE_LEN=4096

# --- Optional: SAMD EAGLE3 tree generation defaults ---
# These control the EAGLE3 draft tree budget.
EAGLE3_TOTAL_TOKEN=60
EAGLE3_DEPTH=7
EAGLE3_TOP_K=10

# --- Optional: resume behavior for benchmark scripts ---
# 0 = skip groups whose output jsonl already has the expected number of rows;
# 1 = delete and rerun all groups.
FORCE_RERUN=0

# --- Optional: CUDA device selector (defaults to 0 if unset) ---
CUDA_VISIBLE_DEVICES=0

# --- Optional: Feishu (Lark) custom bot webhook for long-run notifications ---
# Get from your Feishu group chat → bot → custom bot → "Webhook 地址".
# Leave empty to disable; scripts will fall back to stdout logging.
FEISHU_WEBHOOK_URL=

# --- Optional: short tag prepended to every Feishu message ---
# Useful when one bot serves multiple servers / experiments.
NOTIFY_TAG=medqa-vmiss
