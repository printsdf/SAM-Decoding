# SAM-Decoding evaluation environment variables.
# Copy to .env (gitignored) and fill in your local paths / secrets.
#
#   cp .env.example .env
#   # then edit .env

# --- Required: GPU runtime paths ---
MODEL_PATH=/root/Models/Meta-Llama-3.1-8B-Instruct
TREE_MODEL_PATH=/root/Models/EAGLE3-LLaMA3.1-Instruct-8B

# --- Optional: CUDA device selector (defaults to 0 if unset) ---
CUDA_VISIBLE_DEVICES=0

# --- Optional: Feishu (Lark) custom bot webhook for long-run notifications ---
# Get from your Feishu group chat → bot → custom bot → "Webhook 地址".
# Leave empty to disable; scripts will fall back to stdout logging.
FEISHU_WEBHOOK_URL=

# --- Optional: short tag prepended to every Feishu message ---
# Useful when one bot serves multiple servers / experiments.
NOTIFY_TAG=medqa-vmiss
